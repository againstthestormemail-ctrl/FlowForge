# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase ---
# Public (safe in browser) — used by the Vite frontend, prefix with VITE_
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (Vercel functions in api/)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Phase 3+) ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PROFESSIONAL=

# --- App ---
APP_URL=https://flowforge.app
NODE_ENV=development
